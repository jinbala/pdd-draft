# 浏览器登录状态/缓存（很大，且含账号登录信息，绝对不能进版本库）
chrome_profile/

# Python 缓存
__pycache__/
*.pyc

# 运行产生的记录（每次运行会重新生成，不用存档）
result.csv
run.log

# 调试抓取产物（--inspect-edit 会生成）
inspect*.txt
inspect*.html
inspect*.png

# 本地工具配置
.claude/

# ===== 隐私/密钥防线（以下一律不入库、不上传）=====
# 环境变量与密钥文件
.env
.env.*
*.key
*.pem
*.p12
*.pfx
*.crt
*.credentials
*secret*
*token*
# 本地私有配置（以后要放密钥就放这里，别写进 config.py，config.py 会上传）
config.local.py
config.local.json
private/
